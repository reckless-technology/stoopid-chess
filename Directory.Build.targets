<Project>

  <!-- Stamp the build number into the version: VersionBase from Directory.Build.props plus the
       commit count, like pawnstar's and zenith's builds. Skipped in IDE design-time builds, which
       keep the props default. -->
  <Target Name="ComputeBuildNumber" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-list --count HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitCommitCount Condition="'$(_GitExitCode)' != '0' OR '$(_GitCommitCount)' == ''">0</_GitCommitCount>
      <Version>$(VersionBase).$(_GitCommitCount)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
      <FileVersion>$(Version).0</FileVersion>
      <AssemblyVersion>$(VersionBase).0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

</Project>
