{
  // "setup environment" installs what building, testing and debugging need on this machine (tools/setup-dev.ps1 on
  // Windows, tools/setup-dev.sh on Linux and macOS); "setup environment + tuning tools" adds fastchess, the reference
  // pawnstar and a self-play baseline under ~/tools; "check environment" only reports (the tuning tools too with
  // --tuning / -Tuning, by hand). The match tasks run on every platform from what the tuning setup installs.
  //
  // Every task is a "process" task: VS Code starts the program itself with the arguments as given, through no shell,
  // so a task behaves the same whatever the terminal's default shell is - Windows PowerShell 5.1 (which has no && or
  // ||), PowerShell 7, cmd, bash or zsh. A sequence of commands is a task per command chained by dependsOn ("publish"),
  // never one command line joined by a shell's operators. Where the program or its arguments differ by platform, the
  // task has a linux, an osx and a windows form.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup environment",
      "detail": "Install the .NET SDK, the git hooks and the recommended extensions where missing (tools/setup-dev)",
      "type": "process",
      "command": "${workspaceFolder}/tools/setup-dev.sh",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/setup-dev.ps1"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true }
    },
    {
      "label": "setup environment + tuning tools",
      "detail": "The same, plus fastchess, the reference pawnstar and a self-play baseline under ~/tools",
      "type": "process",
      "command": "${workspaceFolder}/tools/setup-dev.sh",
      "args": ["--tuning"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/setup-dev.ps1", "-Tuning"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true }
    },
    {
      "label": "check environment",
      "detail": "Report what the setup would install, and install nothing",
      "type": "process",
      "command": "${workspaceFolder}/tools/setup-dev.sh",
      "args": ["--check"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/setup-dev.ps1", "-Check"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "build",
      "detail": "Debug build of the whole solution, the Avalonia GUI included (Linux, macOS and Windows)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/StoopidChess.slnx", "-c", "Debug", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "build release",
      "detail": "Release build of the whole solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/StoopidChess.slnx", "-c", "Release", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "test",
      "detail": "Run the xunit test suite (Release, same as CI)",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/StoopidChess.Tests/StoopidChess.Tests.csproj", "-c", "Release"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "test (debug build, asserts on)",
      "detail": "Run the xunit test suite against a Debug build so Debug.Assert checks fire",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/StoopidChess.Tests/StoopidChess.Tests.csproj", "-c", "Debug"],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "selfplay vs baseline",
      "detail": "100 paired games at 12+0.12 against the published baseline (tools/selfplay)",
      "type": "process",
      "linux": {
        "command": "${workspaceFolder}/tools/selfplay.sh",
        "args": ["--pgn", "${workspaceFolder}/selfplay.pgn"]
      },
      "osx": {
        "command": "${workspaceFolder}/tools/selfplay.sh",
        "args": ["--pgn", "${workspaceFolder}/selfplay.pgn"]
      },
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/selfplay.ps1", "-PgnOut", "${workspaceFolder}/selfplay.pgn"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "match vs pawnstar",
      "detail": "40 paired games at 12+0.12 against the reference pawnstar setup-dev --tuning installs (none for Intel Macs)",
      "type": "process",
      "linux": {
        "command": "${workspaceFolder}/tools/match.sh",
        "args": [
          "--opponent", "${userHome}/tools/pawnstar/pawnstar-0.13.593-linux-x86_64",
          "--opponent-option", "option.Threads=1", "--opponent-option", "option.OwnBook=false",
          "--rounds", "20", "--tc", "12+0.12", "--pgn", "${workspaceFolder}/match.pgn"
        ]
      },
      "osx": {
        "command": "${workspaceFolder}/tools/match.sh",
        "args": [
          "--opponent", "${userHome}/tools/pawnstar/pawnstar-0.13.593-macos-arm64",
          "--opponent-option", "option.Threads=1", "--opponent-option", "option.OwnBook=false",
          "--rounds", "20", "--tc", "12+0.12", "--pgn", "${workspaceFolder}/match.pgn"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/match.ps1",
          "-Opponent", "${userHome}/tools/pawnstar/pawnstar-0.13.593-windows-x86_64.exe",
          "-OpponentOptions", "option.Threads=1,option.OwnBook=false",
          "-Rounds", "20", "-TimeControl", "12+0.12", "-PgnOut", "${workspaceFolder}/match.pgn"
        ]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "run desktop gui",
      "detail": "Build and run the Avalonia GUI (Linux, macOS and Windows)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Desktop/StoopidChess.Desktop.csproj", "-c", "Debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "run uci",
      "detail": "Build and run the UCI engine in the terminal (type 'uci', 'position startpos', 'go depth 6', 'quit')",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true }
    },
    {
      "label": "bench",
      "detail": "Fixed-depth search signature and speed (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "--", "bench"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "perft",
      "detail": "Move generation check against all 128 standard positions (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "--", "perft"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "publish",
      "detail": "Self-contained single-file Release builds of the engine and the Avalonia GUI into publish/",
      "dependsOn": ["publish engine", "publish desktop gui"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "publish engine",
      "detail": "Self-contained single-file Release build of the UCI engine into publish/engine (as CI publishes it)",
      "type": "process",
      "command": "dotnet",
      "linux": {
        "args": [
          "publish", "src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "-r", "linux-x64",
          "--self-contained", "-p:PublishSingleFile=true", "-o", "publish/engine"
        ]
      },
      "osx": {
        "args": [
          "publish", "src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "-r", "osx-arm64",
          "--self-contained", "-p:PublishSingleFile=true", "-o", "publish/engine"
        ]
      },
      "windows": {
        "args": [
          "publish", "src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "-r", "win-x64",
          "--self-contained", "-p:PublishSingleFile=true", "-o", "publish/engine"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "publish desktop gui",
      "detail": "Self-contained single-file Release build of the Avalonia GUI into publish/desktop (as CI publishes it)",
      "type": "process",
      "command": "dotnet",
      "linux": {
        "args": [
          "publish", "src/StoopidChess.Desktop/StoopidChess.Desktop.csproj", "-c", "Release", "-r", "linux-x64",
          "--self-contained", "-p:PublishSingleFile=true", "-p:IncludeNativeLibrariesForSelfExtract=true",
          "-o", "publish/desktop"
        ]
      },
      "osx": {
        "args": [
          "publish", "src/StoopidChess.Desktop/StoopidChess.Desktop.csproj", "-c", "Release", "-r", "osx-arm64",
          "--self-contained", "-p:PublishSingleFile=true", "-o", "publish/desktop"
        ]
      },
      "windows": {
        "args": [
          "publish", "src/StoopidChess.Desktop/StoopidChess.Desktop.csproj", "-c", "Release", "-r", "win-x64",
          "--self-contained", "-p:PublishSingleFile=true", "-p:IncludeNativeLibrariesForSelfExtract=true",
          "-o", "publish/desktop"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "publish baseline",
      "detail": "Refresh the self-play baseline in ~/tools/stoopid-baseline from HEAD (run after each accepted change)",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "src/StoopidChess.Uci", "-c", "Release", "-o", "${userHome}/tools/stoopid-baseline"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "clean",
      "detail": "Remove build output",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/StoopidChess.slnx"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
