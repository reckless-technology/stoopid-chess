{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Debug build of the whole solution (the GUI compiles everywhere, runs only on Windows)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/StoopidChess.slnx", "-c", "Debug", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "build release",
      "detail": "Release build of the whole solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/StoopidChess.slnx", "-c", "Release", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "test",
      "detail": "Run the xunit test suite (Release, same as CI)",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/StoopidChess.Tests/StoopidChess.Tests.csproj", "-c", "Release"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "test (debug build, asserts on)",
      "detail": "Run the xunit test suite against a Debug build so Debug.Assert checks fire",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/StoopidChess.Tests/StoopidChess.Tests.csproj", "-c", "Debug"],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "selfplay vs baseline",
      "detail": "100 paired games at 12+0.12 against the published baseline (tools/selfplay)",
      "type": "shell",
      "linux": {
        "command": "${workspaceFolder}/tools/selfplay.sh",
        "args": ["--pgn", "${workspaceFolder}/selfplay.pgn"]
      },
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/selfplay.ps1", "-PgnOut", "${workspaceFolder}/selfplay.pgn"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "match vs pawnstar",
      "detail": "40 paired games at 10+0.1 against pawnstar with fastchess (tools/match)",
      "type": "shell",
      "linux": {
        "command": "${workspaceFolder}/tools/match.sh",
        "args": [
          "--opponent", "${userHome}/tools/pawnstar/pawnstar-0.13.593-linux-x86_64",
          "--opponent-option", "option.Threads=1", "--opponent-option", "option.OwnBook=false",
          "--rounds", "20", "--tc", "10+0.1", "--pgn", "${workspaceFolder}/match.pgn"
        ]
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile", "-File", "${workspaceFolder}/tools/match.ps1",
          "-Opponent", "C:/Users/jonny/tools/pawnstar/pawnstar-0.13.593-windows-x86_64.exe",
          "-OpponentOptions", "option.Threads=1", "option.OwnBook=false",
          "-Rounds", "20", "-TimeControl", "10+0.1", "-PgnOut", "${workspaceFolder}/match.pgn"
        ]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "run gui",
      "detail": "Build and run the Windows Forms GUI (Windows only)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Gui/StoopidChess.Gui.csproj", "-c", "Debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "run uci",
      "detail": "Build and run the UCI engine in the terminal (type 'uci', 'position startpos', 'go depth 6', 'quit')",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true }
    },
    {
      "label": "bench",
      "detail": "Fixed-depth search signature and speed (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "--", "bench"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "perft",
      "detail": "Move generation check against all 128 standard positions (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StoopidChess.Uci/StoopidChess.Uci.csproj", "-c", "Release", "--", "perft"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "publish",
      "detail": "Self-contained single-file Release build(s) into publish/ (GUI included on Windows)",
      "type": "shell",
      "linux": {
        "command": "dotnet publish src/StoopidChess.Uci/StoopidChess.Uci.csproj -c Release -r linux-x64 --self-contained -p:PublishSingleFile=true -o publish/engine"
      },
      "windows": {
        "command": "dotnet publish src/StoopidChess.Gui/StoopidChess.Gui.csproj -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o publish/gui && dotnet publish src/StoopidChess.Uci/StoopidChess.Uci.csproj -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o publish/engine"
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "publish baseline",
      "detail": "Refresh the self-play baseline from HEAD (run after each accepted change)",
      "type": "shell",
      "linux": {
        "command": "dotnet publish src/StoopidChess.Uci -c Release -o ~/tools/stoopid-baseline"
      },
      "windows": {
        "command": "dotnet publish src/StoopidChess.Uci -c Release -o C:/Users/jonny/tools/stoopid-baseline"
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "clean",
      "detail": "Remove build output",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/StoopidChess.slnx"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
