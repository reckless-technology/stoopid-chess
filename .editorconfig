root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,slnx,csproj,props}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_new_line_before_open_brace = all
csharp_space_after_keywords_in_control_flow_statements = true
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion

# Naming, after Microsoft's "C# identifier naming rules and conventions"
# (learn.microsoft.com/dotnet/csharp/fundamentals/coding-style/identifier-names): PascalCase for types, members and
# constants and static readonly fields, camelCase for locals and parameters, _camelCase for private and internal fields
# that are not static readonly (no s_ or other Hungarian prefix), an I on interfaces and a T on type parameters.
# Violations are IDE1006 warnings, which `dotnet format style --verify-no-changes` fails on (the hook and CI run it). The repository declares no
# interop of its own (the SDL3 bindings are a package); a file of declarations that mirror native names, SDLK_* say,
# would opt out with a section of its own at the end of this file.

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.type_parameter_style.capitalization = pascal_case
dotnet_naming_style.type_parameter_style.required_prefix = T

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.non_private_members.applicable_kinds = property, method, field, event, local_function
dotnet_naming_symbols.non_private_members.applicable_accessibilities = public, protected, protected_internal, private_protected
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_members.applicable_kinds = property, method, event, local_function
dotnet_naming_symbols.private_members.applicable_accessibilities = private, internal
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local

dotnet_naming_rule.interfaces_need_i.symbols = interfaces
dotnet_naming_rule.interfaces_need_i.style = interface_style
dotnet_naming_rule.interfaces_need_i.severity = warning
dotnet_naming_rule.type_parameters_need_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_need_t.style = type_parameter_style
dotnet_naming_rule.type_parameters_need_t.severity = warning
dotnet_naming_rule.types_are_pascal.symbols = types
dotnet_naming_rule.types_are_pascal.style = pascal_case
dotnet_naming_rule.types_are_pascal.severity = warning
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = warning
dotnet_naming_rule.non_private_members_are_pascal.symbols = non_private_members
dotnet_naming_rule.non_private_members_are_pascal.style = pascal_case
dotnet_naming_rule.non_private_members_are_pascal.severity = warning
dotnet_naming_rule.private_members_are_pascal.symbols = private_members
dotnet_naming_rule.private_members_are_pascal.style = pascal_case
dotnet_naming_rule.private_members_are_pascal.severity = warning
dotnet_naming_rule.static_readonly_fields_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal.severity = warning
dotnet_naming_rule.private_instance_fields_need_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_need_underscore.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_need_underscore.severity = warning
dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel_case
dotnet_naming_rule.locals_and_parameters_are_camel.severity = warning
