#!/bin/sh
# Pre-commit hook: refuse a commit made under any identity but Jonny Reckless <jonny@recklesstechnology.com>,
# and refuse the commit if `dotnet format` would change any of the code. The identity is every commit's in the
# reckless-technology organisation; the pre-push hook checks the commits a rebase or a cherry-pick makes.
#
# Enable it once per clone with:   git config core.hooksPath .githooks
# Fix a refusal with:              dotnet format StoopidChess.slnx    (then stage the result)
#
# The check runs only when C# sources or project files are staged, and it examines the working
# tree, so unstaged formatting problems in those files are reported too.

identity="jonny@recklesstechnology.com"
for role in AUTHOR COMMITTER; do
    email=$(git var "GIT_${role}_IDENT" 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p')
    if [ "$email" != "$identity" ]; then
        echo "pre-commit: this commit's $(echo "$role" | tr 'A-Z' 'a-z') would be <$email>; every commit here is <$identity>." >&2
        echo "pre-commit:   git config user.name 'Jonny Reckless' && git config user.email $identity" >&2
        exit 1
    fi
done

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(cs|csproj|props|editorconfig)$'; then
    echo "pre-commit: checking formatting with dotnet format..."
    # The whole solution loads on every OS.
    if ! dotnet format StoopidChess.slnx --verify-no-changes; then
        echo "pre-commit: formatting problems found. Run 'dotnet format StoopidChess.slnx', stage the result and commit again." >&2
        exit 1
    fi
fi
exit 0
