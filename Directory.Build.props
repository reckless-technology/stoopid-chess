<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NeutralLanguage>en</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Stoopid Chess</Product>
    <Company>Reckless Technology Ltd</Company>
    <Authors>Jonny Reckless</Authors>
    <Copyright>© Jonny Reckless 2009-2026</Copyright>
    <!-- The version is MAJOR.MINOR.BUILD from git alone, the rule every reckless-technology project
         follows: MAJOR.MINOR from the nearest annotated tag vMAJOR.MINOR, BUILD the number of commits
         since it. Directory.Build.targets derives it at build time; this is the fallback for a tree
         with no such tag reachable and for IDE design-time builds. Nothing here is edited to release:
         tag main and push the tag. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

</Project>
