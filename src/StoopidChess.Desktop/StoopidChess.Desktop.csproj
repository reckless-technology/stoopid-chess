<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StoopidChess.Desktop</RootNamespace>
    <AssemblyName>StoopidChess.Desktop</AssemblyName>
    <Description>Stoopid Chess: a cross-platform Avalonia chess GUI that plays against any UCI engine.</Description>
    <!-- The .exe's icon on Windows; tools/make-icons.py draws it, and the macOS app's .icns, from packaging/icon. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The P/Invoke source generator ([LibraryImport], WindowsConsole) emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoopidChess.Core\StoopidChess.Core.csproj" />
    <ProjectReference Include="..\StoopidChess.Play\StoopidChess.Play.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoopidChess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The piece images (the cburnett set, see the README) and AppIcon.ico and AppIcon.png, the window's icon. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
