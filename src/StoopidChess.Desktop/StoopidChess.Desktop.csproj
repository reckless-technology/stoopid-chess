<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StoopidChess.Desktop</RootNamespace>
    <AssemblyName>StoopidChess.Desktop</AssemblyName>
    <Description>Stoopid Chess: a cross-platform Avalonia chess GUI that plays against any UCI engine.</Description>
    <ApplicationIcon>../StoopidChess.Gui/BlackQueen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoopidChess.Core\StoopidChess.Core.csproj" />
    <ProjectReference Include="..\StoopidChess.Play\StoopidChess.Play.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The piece images are copies of src/StoopidChess.Gui/Resources (the WinForms GUI embeds them per-form). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
