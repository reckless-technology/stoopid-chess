<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StoopidChess.Desktop</RootNamespace>
    <AssemblyName>StoopidChess.Desktop</AssemblyName>
    <Description>Stoopid Chess: a cross-platform chess GUI, drawn with SkiaSharp in an SDL3 window, that plays against any UCI engine.</Description>
    <!-- The .exe's icon on Windows; tools/make-icons.py draws it, and the macOS app's .icns, from packaging/icon. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The P/Invoke source generator ([LibraryImport], WindowsConsole) emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoopidChess.Core\StoopidChess.Core.csproj" />
    <ProjectReference Include="..\StoopidChess.Play\StoopidChess.Play.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoopidChess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded in the assembly: the piece images (the cburnett set, see the README), AppIcon.png (the window's icon;
         AppIcon.ico is the .exe's) and the fonts with their licences (Assets/Fonts, the SIL Open Font License). -->
    <EmbeddedResource Include="Assets\**" />
  </ItemGroup>

</Project>
