<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Info.plist of "Stoopid Chess.app", the Avalonia GUI as macOS opens it from Finder. The release workflow
     (.github/workflows/release.yml) copies it into the bundle and writes the version over @VERSION@. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Stoopid Chess</string>
    <key>CFBundleExecutable</key>
    <string>StoopidChess.Desktop</string>
    <key>CFBundleIconFile</key>
    <string>StoopidChess.icns</string>
    <key>CFBundleIdentifier</key>
    <string>com.recklesstechnology.stoopid-chess</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Stoopid Chess</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.board-games</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© Jonny Reckless 2009-2026. Free software under the GNU General Public License, version 3.</string>
</dict>
</plist>
